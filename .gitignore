# ─────────────────────────────────────────────────────────────────────────────
# Root .gitignore — UCC SCA Department Archive & Activity RMS
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment Variables & Secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
*.env
**/.env
backend/.env

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Python / Backend Cache & Virtual Environments ────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
build/
**/build/
dist/
**/dist/
*.egg-info/
**/*.egg-info/
.coverage
htmlcov/

# ── Build & Dist Outputs ─────────────────────────────────────────────────────
.vite/
**/.vite/
.next/
**/.next/
out/
**/out/

# ── Mobile / Expo Artifacts ──────────────────────────────────────────────────
.expo/
**/.expo/
.metro/
**/.metro/
*.apk
*.aab
*.ipa

# ── Logs & Debug Files ───────────────────────────────────────────────────────
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Operating System & Editor Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDEs & Code Editors ──────────────────────────────────────────────────────
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Temporary & Scratch Files ────────────────────────────────────────────────
tmp/
**/tmp/
temp/
**/temp/

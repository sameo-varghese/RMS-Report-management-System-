# ─────────────────────────────────────────────────────────────────────────────
# UCC School of Computer Applications — Department Archive & Activity RMS
# MCA CP 307 Mini Project | Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values before running.

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Connection string from MongoDB Atlas or local MongoDB instance
# Defaults to in-memory/mock fallback if unconfigured
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ucc_rms?retryWrites=true&w=majority

# ── Cloudinary (Media Storage) ───────────────────────────────────────────────
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Free tier API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── JWT Security ──────────────────────────────────────────────────────────────
# Change to a strong random secret key in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE_HOURS=24

# ── CORS (Frontend URL) ───────────────────────────────────────────────────────
# Local development URL for Vite web frontend
FRONTEND_URL=http://localhost:5173
